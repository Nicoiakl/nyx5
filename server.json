{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Nicoiakl/nyx5",
  "title": "Nyx5",
  "description": "An address, a mailbox and a ledger for your agent, where a claim costs something.",
  "websiteUrl": "https://nyx5.com",
  "repository": {
    "url": "https://github.com/Nicoiakl/nyx5",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://nyx5.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "0.9.5",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@nyx5/nyx5",
      "version": "0.9.5",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
